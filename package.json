{
  "name": "@hyperse/hyper-env",
  "version": "1.1.1",
  "description": "Populates your environment from .env files at run-time rather than build-time.",
  "keywords": [
    "hyperse",
    "next env",
    "next runtime env",
    "hyper env"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:hyperse-io/hyper-env.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./dist/index.d.ts"
    },
    "./setup-env": {
      "import": "./dist/setup-env.js",
      "types": "./dist/setup-env.d.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "hyper-env": "./bin/hyper-env.mjs",
    "hyper-next-standalone": "./bin/hyper-next-standalone.mjs"
  },
  "files": [
    "./bin/",
    "./dist/",
    "./index.js"
  ],
  "scripts": {
    "build": "tsup",
    "next": "next build",
    "lint": "eslint .",
    "lint-fix": "yarn lint --fix",
    "test": "run-s test-unit",
    "test-unit": "vitest run",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "lint-staged-files": "lint-staged --allow-empty",
    "changeset": "changeset",
    "release": "yarn build && changeset publish",
    "cz": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "resolutions": {
    "typescript": "6.x"
  },
  "dependencies": {
    "@vercel/nft": "^1.11.0",
    "dotenv": "^18.0.8",
    "dotenv-expand": "^1000.0.0",
    "globby": "^16.2.4",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hyperse/eslint-config-hyperse": "^1.7.5",
    "@hyperse/exec-program": "^1.2.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "next": "^16.4.1",
    "npm-run-all": "^4.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "6.x",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
